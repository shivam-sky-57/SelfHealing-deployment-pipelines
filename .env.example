# ============================================================
# Self-Healing Deployment Pipeline — Environment Variables
# ============================================================
# Copy this file to .env and fill in your real values.
# NEVER commit .env to Git.
# ============================================================

# ---- Groq LLM API ----
# Obtain from https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama3-8b-8192
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions

# ---- GitHub Integration ----
# Personal Access Token with permissions: repo (read), issues (write), pull_requests (write)
# Obtain from https://github.com/settings/tokens
GITHUB_TOKEN=your_github_token_here
GITHUB_OWNER=your_github_username_or_org
GITHUB_REPO=self-healing-deployment-pipeline

# ---- Kubernetes ----
# Namespace where demo-app is deployed
KUBE_NAMESPACE=demo
# Deployment name to monitor
KUBE_DEPLOYMENT_NAME=demo-app

# ---- demo-app ----
# Set to "true" to force every request to fail (used for live demos)
FORCE_FAILURE=false

# ---- healing-agent ----
# Port the healing-agent listens on
HEALING_AGENT_PORT=8081
# Rollback cooldown in minutes (prevents rollback thrashing)
ROLLBACK_COOLDOWN_MINUTES=5
# How many minutes after a deployment a failure is considered "post-deploy"
POST_DEPLOY_WINDOW_MINUTES=10

# ---- GitHub Actions (set these as GitHub Repository Secrets) ----
# GHCR_USERNAME   = your GitHub username
# GHCR_TOKEN      = a GitHub token with packages:write scope
# KUBECONFIG_B64  = base64-encoded kubeconfig for your local cluster
